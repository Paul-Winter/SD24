<Window x:Class="TeacherScheduleApp.TeachersListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список преподавателей" Height="500" Width="800"
        Background="#F4F7F6" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#20c997" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <TextBlock Text="Педагогический состав ITpot" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#D1D5DB" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <DataGrid x:Name="TeachersGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" BorderThickness="0" RowHeaderWidth="0" 
                      RowHeight="40" FontSize="14" AlternatingRowBackground="#F9FAFB"
                      MouseDoubleClick="TeachersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding ФИО}" Width="250">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Стаж" Binding="{Binding Стаж}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Специализация" Binding="{Binding Специализация}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Visibility="Hidden"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>