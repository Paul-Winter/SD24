<Window x:Class="TeacherScheduleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITpot" Height="780" Width="1200"
        Background="#F4F7F6" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20c997"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#17a2b8"/>
        </Style>

        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#20c997"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17a2b8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#28a745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#dc3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCFBF1"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#D1D5DB" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="#8E24AA" Width="110" Height="40" CornerRadius="6">
                    <TextBlock Text="ITpot" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Менеджер расписаний" Foreground="#1F2937" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
            <Button x:Name="btnLoadData" Content="🔄 Обновить данные" Click="btnLoadData_Click"/>
            <Button x:Name="btnMarkAll" Content="✅ Отметить всех" Style="{StaticResource GreenButton}" Click="btnMarkAll_Click"/>
            <Button x:Name="btnCancelAll" Content="❌ Отменить всех" Style="{StaticResource RedButton}" Click="btnCancelAll_Click"/>
            <Button x:Name="btnLoadWorkload" Content=" Показать загруженность" Click="btnLoadWorkload_Click"/>
            <Button x:Name="btnOpenTeachers" Content=" Список преподавателей" Click="btnOpenTeachers_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#D1D5DB" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <DataGrid x:Name="ScheduleDataGrid" 
                      AutoGenerateColumns="False" IsReadOnly="True" 
                      CanUserAddRows="False" FontSize="14"
                      Background="Transparent" BorderThickness="0" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                      RowHeaderWidth="0" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding Преподаватель}" Width="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Предмет" Binding="{Binding Предмет}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Группа" Binding="{Binding Группа}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#8E24AA"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Аудитория" Binding="{Binding Аудитория}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Дата, StringFormat='\{0:dd.MM.yyyy\}'}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Время" Binding="{Binding Время}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Часы" Binding="{Binding Часы}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Статус" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Статус}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Статус}" Value="проведено">
                                        <Setter Property="Foreground" Value="#28a745"/>
                                        <Setter Property="TextBlock.Text" Value="✔️ Проведено"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Статус}" Value="отменено">
                                        <Setter Property="Foreground" Value="#dc3545"/>
                                        <Setter Property="TextBlock.Text" Value="❌ Отменено"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Действия" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="ℹ️" Background="#17a2b8" Foreground="White" 
                                            Width="32" Height="28" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"
                                            Click="btnRowInfo_Click"/>
                                    <Button Content="✔️" Background="#28a745" Foreground="White" 
                                            Width="32" Height="28" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"
                                            Click="btnRowDone_Click"/>
                                    <Button Content="❌" Background="#dc3545" Foreground="White" 
                                            Width="32" Height="28" BorderThickness="0" Cursor="Hand"
                                            Click="btnRowCancel_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="Сводка по загруженности преподавателей:" Margin="5,0,0,10" FontWeight="Bold" FontSize="16" Foreground="#1F2937"/>

        <Border Grid.Row="4" Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#D1D5DB" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <DataGrid x:Name="WorkloadDataGrid" 
                      AutoGenerateColumns="True" IsReadOnly="True" 
                      CanUserAddRows="False" FontSize="14" 
                      Background="Transparent" BorderThickness="0" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                      RowHeaderWidth="0" AlternationCount="2"/>
        </Border>
    </Grid>
</Window>