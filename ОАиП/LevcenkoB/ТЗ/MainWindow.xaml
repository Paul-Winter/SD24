<Window x:Class="TeacherScheduleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер расписаний" Height="500" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель с кнопками -->
        <StackPanel Orientation="Horizontal" Margin="10">
            <Button x:Name="btnLoadData" Content="Загрузить расписание" 
                    Padding="10,5" Click="btnLoadData_Click" Margin="0,0,10,0"/>

            <Button x:Name="btnMarkDone" Content="Отметить как проведенную" 
                    Padding="10,5" Click="btnMarkDone_Click" Margin="0,0,10,0"/>

            <Button x:Name="btnMarkCancelled" Content="Отменить пару" 
                    Padding="10,5" Click="btnMarkCancelled_Click"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="ScheduleDataGrid" Grid.Row="1" Margin="10" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" RowHeight="30" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Преподаватель" Binding="{Binding Преподаватель}" Width="200"/>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Предмет}" Width="220"/>
                <DataGridTextColumn Header="Аудитория" Binding="{Binding Аудитория}" Width="100"/>
                <DataGridTextColumn Header="День" Binding="{Binding День}" Width="60"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding Начало, StringFormat='\{0:HH:mm\}'}" Width="80"/>

                <DataGridTemplateColumn Header="Статус" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Статус}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Статус}" Value="проведено">
                                    <Setter Property="Foreground" Value="Green"/>
                                    <Setter Property="TextBlock.Text" Value="✔️ Проведено"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Статус}" Value="отменено">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="TextBlock.Text" Value="❌ Отменено"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Часы" Binding="{Binding Часы}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>