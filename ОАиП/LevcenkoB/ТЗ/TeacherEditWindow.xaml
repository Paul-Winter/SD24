<Window x:Class="TeacherScheduleApp.TeacherEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование преподавателя" Height="450" Width="400" Background="#F4F7F6" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ФИО:" Margin="0,0,0,5" FontWeight="Bold"/>
        <TextBox x:Name="txtFio" Grid.Row="1" Height="30" Margin="0,0,0,10"/>

        <TextBlock Text="Email:" Grid.Row="2" Margin="0,0,0,5" FontWeight="Bold"/>
        <TextBox x:Name="txtEmail" Grid.Row="3" Height="30" Margin="0,0,0,10"/>

        <TextBlock Text="Год рождения:" Grid.Row="4" Margin="0,0,0,5" FontWeight="Bold"/>
        <TextBox x:Name="txtYear" Grid.Row="5" Height="30" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" VerticalAlignment="Bottom">
            <TextBlock Text="Стаж (лет) и Специализация (через запятую):" Margin="0,0,0,5" FontWeight="Bold"/>
            <TextBox x:Name="txtExp" Height="30" Margin="0,0,0,10"/>
            <TextBox x:Name="txtSpec" Height="60" Margin="0,0,0,15" TextWrapping="Wrap" AcceptsReturn="True"/>

            <Button Content="💾 Сохранить" Background="#28a745" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>