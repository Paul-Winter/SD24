<Window x:Class="TeacherScheduleApp.GroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Группы и нагрузка" Height="600" Width="900" Background="#F4F7F6" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <TabControl>
            <!-- Вкладка 1: Список групп -->
            <TabItem Header="Список групп">
                <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="White" RowHeight="30" Margin="10"/>
            </TabItem>

            <!-- Вкладка 2: Нагрузка по дисциплинам и неделям -->
            <TabItem Header="Нагрузка групп">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="🔄 Рассчитать нагрузку" HorizontalAlignment="Left" Margin="0,0,0,10" Click="btnCalcLoad_Click"/>
                    <DataGrid x:Name="LoadGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Background="White" RowHeight="30"/>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Сверка групп и зачеты -->
            <TabItem Header="Сверка и Аттестация">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="🔄 Сверить данные" HorizontalAlignment="Left" Margin="0,0,0,10" Click="btnCompare_Click"/>
                    <DataGrid x:Name="CompareGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Background="White" RowHeight="30"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>