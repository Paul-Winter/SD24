@startuml IDE_Booster
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

enum PerformanceMode {
  Standard
  Performance
  Manual
}


class MainForm {
  + string ProgramName
  + string Version
  + PerformanceMode SelectedMode
  + string StatusText
  + void SelectIde()
  + void LaunchIde()
  + void StartOptimization()
  + void StopOptimization()
  + void RefreshMonitor()
  + void ShowError(string message)
}

class IdeManager {
  - string _lastIdePath
  + string SelectedIdePath
  + string SelectedIdeName
  + bool SelectIde()
  + bool IsIdeRunning()
  + bool LaunchIde()
  + string GetIdeStatus()
}

class ProcessManager {
  + Process FindProcessByName(string name)
  + Process GetIdeProcess(string exeName)
  + List<Process> GetUserProcesses()
  + bool ChangePriority(Process p, ProcessPriorityClass priority)
  + ProcessPriorityClass GetPriority(Process p)
  + bool IsSystemProcess(Process p)
}

class OptimizationManager {
  - Dictionary<int, ProcessPriorityClass> _originalPriorities
  + PerformanceMode CurrentMode
  + bool IsActive
  + bool Start(PerformanceMode mode)
  + void Stop()
  + void ApplyMode(PerformanceMode mode)
  + void SaveOriginalPriority(Process p)
  + void RestoreAllPriorities()
  + void OnIdeProcessExited()
}

class SystemMonitor {
  + double CpuLoad
  + double RamUsedMb
  + double RamTotalMb
  + int ProcessCount
  + double IdeRamUsageMb
  + double IdeCpuUsage
  + void Start(int intervalMs)
  + void Stop()
  + void Update()
}

class SettingsManager {
  + string LastIdePath
  + PerformanceMode LastMode
  + List<string> SecondaryProcesses
  + void Load()
  + void Save()
}


MainForm --> IdeManager : использует
MainForm --> OptimizationManager : управляет оптимизацией
MainForm --> SystemMonitor : отображает метрики
MainForm --> SettingsManager : загружает/сохраняет настройки
MainForm --> PerformanceMode : выбирает режим

OptimizationManager --> IdeManager : получает процесс IDE
OptimizationManager --> ProcessManager : меняет приоритеты
OptimizationManager --> PerformanceMode : применяет режим
OptimizationManager --> SettingsManager : сохраняет исходные приоритеты

IdeManager --> ProcessManager : ищет/проверяет процесс

SettingsManager ..> PerformanceMode : хранит последний режим

@enduml
