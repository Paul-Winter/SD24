<Window x:Class="TeachersAssistant.AverageGrades_wpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeachersAssistant"
        mc:Ignorable="d"
                WindowState="Maximized"
        MinWidth="1024" MinHeight="768"
        Background="#20c997"
        FontFamily="Segoe UI, Arial, sans-serif" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Стиль для кнопок бокового меню -->
        <Style x:Key="MenuButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="indicator" Background="Transparent" CornerRadius="2,0,0,2"/>
                                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0FDF9"/>
                                <Setter Property="Foreground" Value="#20c997"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E6F9F4"/>
                                <Setter TargetName="indicator" Property="Background" Value="#dc3545"/>
                                <Setter Property="Foreground" Value="#20c997"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="15" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- трушный стиль для CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" Background="White" BorderBrush="#CCCCCC" BorderThickness="2" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3,7 L 7,11 L 13,3" Stroke="White" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#20c997"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#20c997"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#20c997"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для групп (наследуется от ModernCheckBox, добавляет блокировку) -->
        <Style x:Key="SpecificGroupCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Style.Triggers>
                <!-- Если "Все группы" выбрано, то эти галочки становятся неактивными и бледными -->
                <DataTrigger Binding="{Binding ElementName=CbAllGroups, Path=IsChecked}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для таблицы -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="RowHeight" Value="45"/>
            <Setter Property="ColumnHeaderHeight" Value="45"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FBF9"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <!-- Стиль для заголовков таблицы -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#20c997"/>
        </Style>
    </Window.Resources>

    <!-- Основной контейнер -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="White" CornerRadius="0,20,20,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,30,20,20">
                    <TextBlock Text="Помощник" FontSize="24" FontWeight="Bold" Foreground="#20c997"/>
                    <TextBlock Text="по успеваемости" FontSize="14" Foreground="#888888"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <RadioButton Content="Просроченные ДЗ" Style="{StaticResource MenuButton}" GroupName="Menu" Click="ExpiredHW_ButtonClick"/>
                    <RadioButton Content="Неаттестации" Style="{StaticResource MenuButton}" GroupName="Menu" Click="Na_ButtonClick"/>
                    <RadioButton Content="Статистика опозданий" Style="{StaticResource MenuButton}" GroupName="Menu" Click="StatisticsOnLateness_ButtonClick"/>
                    <RadioButton Content="Средние оценки" Style="{StaticResource MenuButton}" IsChecked="True" GroupName="Menu"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="20,0,20,0">
                <TextBlock Text="IT TOP College" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>

            </Grid>

            <!-- ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="20,10,20,20">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ФИЛЬТРЫ -->
                    <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Фильтр по группам:" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <!-- Дала имя CbAllGroups и повесила событие Checked -->
                                <CheckBox x:Name="CbAllGroups" Content="Все группы" Style="{StaticResource ModernCheckBox}" IsChecked="True" Margin="0,0,30,0" Checked="CbAllGroups_Checked"/>

                                <Border Width="2" Background="#DDDDDD" Margin="0,0,30,0" CornerRadius="1"/>

                                <!-- Другие галочки используют стиль SpecificGroupCheckBox и вешают событие Checked -->
                                <CheckBox x:Name="CbGroup6" Content="9/2-РПО-25/1" Style="{StaticResource SpecificGroupCheckBox}" Checked="CbSpecificGroup_Checked"/>
                                <CheckBox x:Name="CbGroup5" Content="9/2-ГД-25/1" Style="{StaticResource SpecificGroupCheckBox}" Checked="CbSpecificGroup_Checked"/>
                                <CheckBox x:Name="CbGroup4" Content="9/3-РПО-24/1" Style="{StaticResource SpecificGroupCheckBox}" Checked="CbSpecificGroup_Checked"/>
                                <CheckBox x:Name="CbGroup3" Content="9/3-ГД-24/1" Style="{StaticResource SpecificGroupCheckBox}" Checked="CbSpecificGroup_Checked"/>
                                <CheckBox x:Name="CbGroup2" Content="9/4-РПО-23/1" Style="{StaticResource SpecificGroupCheckBox}" Checked="CbSpecificGroup_Checked"/>
                                <CheckBox x:Name="CbGroup1" Content="9/4-ГД-23/1" Style="{StaticResource SpecificGroupCheckBox}" Checked="CbSpecificGroup_Checked"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>


                    <DataGrid x:Name="StudentsDataGrid" Grid.Row="1" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="1*"/>
                            <DataGridTextColumn Header="Работа на паре" Binding="{Binding OverdueCount}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#dc3545"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
